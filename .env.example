# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Threat Intel APIs (all have free tiers) ---
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
OTX_API_KEY=

# --- Alerting webhooks (pick one or more) ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# --- Pipeline behavior ---
MINI_SIEM_LOG_LEVEL=INFO
MINI_SIEM_ALERT_MIN_SEVERITY=medium
MINI_SIEM_ENRICH_ENABLED=true
MINI_SIEM_BUSINESS_HOURS_START=08
MINI_SIEM_BUSINESS_HOURS_END=19

# --- Output paths ---
MINI_SIEM_EVENTS_OUT=data/output/events.jsonl
MINI_SIEM_ALERTS_OUT=data/output/alerts.jsonl
